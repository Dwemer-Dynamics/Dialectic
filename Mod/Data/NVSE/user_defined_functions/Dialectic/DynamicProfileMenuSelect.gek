int iButton

Begin Function {iButton}
    if eval iButton < 0 || iButton > 2
        return
    endif

    if eval iButton == 0
        WriteStringToFile "Data\\NVSE\\Plugins\\dialectic_dynamic_profile_select.tmp" 0 "0\n"
        PrintC "[Dialectic] Requesting target dynamic profile update"
    elseif eval iButton == 1
        WriteStringToFile "Data\\NVSE\\Plugins\\dialectic_dynamic_profile_select.tmp" 0 "1\n"
        PrintC "[Dialectic] Requesting nearby dynamic profile updates"
    elseif eval iButton == 2
        WriteStringToFile "Data\\NVSE\\Plugins\\dialectic_dynamic_profile_select.tmp" 0 "2\n"
        PrintC "[Dialectic] Requesting Narrator dynamic profile update"
    endif
End
