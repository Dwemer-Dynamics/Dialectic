int iKey
begin function {}
    ; Hotkeys are owned by the DLL. Remove handlers retained by older saves so
    ; one physical key press can never dispatch through two systems.
    set iKey to 1
    while eval iKey <= 88
        SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 iKey
        SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 iKey
        SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 iKey
        let iKey += 1
    loop

    ; Extended keyboard scan codes used by xNVSE for numpad enter/arrows/etc.
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 156
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 156
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 156
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 157
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 157
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 157
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 181
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 181
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 181
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 183
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 183
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 183
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 184
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 184
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 184
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 199
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 199
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 199
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 200
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 200
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 200
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 201
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 201
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 201
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 203
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 203
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 203
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 205
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 205
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 205
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 207
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 207
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 207
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 208
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 208
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 208
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 209
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 209
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 209
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 210
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 210
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 210
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltActionsKeyDown.txt") 0 211
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HaltHotkeyKeyDown.txt") 0 211
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0 211

    WriteStringToFile "Data\\NVSE\\Plugins\\dialectic_hotkey_bridge_status.txt" 0 "registered=0 owner=dll legacy_handlers_cleared=1%r"
end
