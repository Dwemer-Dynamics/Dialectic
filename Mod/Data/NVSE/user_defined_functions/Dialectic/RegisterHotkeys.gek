int iTalk
int iVoice
int iManual
int iControl
int iHalt
int iOpenMicMute
int iPipVision

begin function {}
    ; A handler without a scan-code argument removes every prior registration
    ; for that UDF, including bindings retained by an existing save.
    SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 0
    SetOnKeyUpEventHandler (CompileScript "Dialectic/HotkeyKeyUp.txt") 0

    let iTalk := DialecticGetConfigInt "Hotkeys" "TalkToNPC" 0
    let iVoice := DialecticGetConfigInt "Hotkeys" "ToggleVoice" 0
    let iManual := DialecticGetConfigInt "Hotkeys" "ManualActivate" 0
    let iControl := DialecticGetConfigInt "Hotkeys" "DialecticControl" 0
    let iHalt := DialecticGetConfigInt "Hotkeys" "StopTalking" 0
    let iOpenMicMute := DialecticGetConfigInt "Hotkeys" "OpenMicMute" 0
    let iPipVision := DialecticGetConfigInt "Hotkeys" "PipVision" 0

    if iTalk > 0
        SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 1 iTalk
        SetOnKeyUpEventHandler (CompileScript "Dialectic/HotkeyKeyUp.txt") 1 iTalk
    endif
    if iVoice > 0
        SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 1 iVoice
        SetOnKeyUpEventHandler (CompileScript "Dialectic/HotkeyKeyUp.txt") 1 iVoice
    endif
    if iManual > 0
        SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 1 iManual
        SetOnKeyUpEventHandler (CompileScript "Dialectic/HotkeyKeyUp.txt") 1 iManual
    endif
    if iControl > 0
        SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 1 iControl
        SetOnKeyUpEventHandler (CompileScript "Dialectic/HotkeyKeyUp.txt") 1 iControl
    endif
    if iHalt > 0
        SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 1 iHalt
        SetOnKeyUpEventHandler (CompileScript "Dialectic/HotkeyKeyUp.txt") 1 iHalt
    endif
    if iOpenMicMute > 0
        SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 1 iOpenMicMute
        SetOnKeyUpEventHandler (CompileScript "Dialectic/HotkeyKeyUp.txt") 1 iOpenMicMute
    endif
    if iPipVision > 0
        SetOnKeyDownEventHandler (CompileScript "Dialectic/HotkeyKeyDown.txt") 1 iPipVision
        SetOnKeyUpEventHandler (CompileScript "Dialectic/HotkeyKeyUp.txt") 1 iPipVision
    endif

    WriteStringToFile "Data\\NVSE\\Plugins\\dialectic_hotkey_bridge_status.txt" 0 "registered=1 owner=jip_events talk=%g voice=%g control=%g manual=%g halt=%g open_mic_mute=%g pipvision=%g%r" iTalk iVoice iControl iManual iHalt iOpenMicMute iPipVision
end
