float fValue
int iMenu
int iSubmenu
int iOption
array_var aJSON

Begin Function {fValue, iMenu, iSubmenu, iOption, aJSON}
    if eval fValue <= 0
        return
    endif

    if eval iOption == 2
        SetINIIntC "Tools:AgentAddTarget" 0 "Data\\NVSE\\Plugins\\dialectic_custom.ini"
        DialecticManageAIAgents 0
    elseif eval iOption == 3
        SetINIIntC "Tools:AgentAddNearby" 0 "Data\\NVSE\\Plugins\\dialectic_custom.ini"
        DialecticManageAIAgents 1
    elseif eval iOption == 4
        SetINIIntC "Tools:AgentRemoveTarget" 0 "Data\\NVSE\\Plugins\\dialectic_custom.ini"
        DialecticManageAIAgents 2
    elseif eval iOption == 5
        SetINIIntC "Tools:AgentRemoveAll" 0 "Data\\NVSE\\Plugins\\dialectic_custom.ini"
        DialecticManageAIAgents 3
    elseif eval iOption == 7
        SetINIIntC "Tools:AgentListActive" 0 "Data\\NVSE\\Plugins\\dialectic_custom.ini"
        DialecticManageAIAgents 4
    elseif eval iOption == 8
        SetINIIntC "Tools:AgentListNearby" 0 "Data\\NVSE\\Plugins\\dialectic_custom.ini"
        DialecticManageAIAgents 5
    endif
End
