float fValue
int iMenu
int iSubmenu
int iOption
array_var aJSON

Begin Function {fValue, iMenu, iSubmenu, iOption, aJSON}
    if eval fValue <= 0
        return
    endif

    SetINIIntC "Tools:InitializeDialectic" 0 "Data\\NVSE\\Plugins\\dialectic_custom.ini"
    call (CompileScript "Dialectic/RunDialecticInitialization.gek")
End
