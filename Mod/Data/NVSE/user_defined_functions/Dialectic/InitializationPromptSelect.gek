int iButton

Begin Function {iButton}
    SetINIIntC "Setup:InitializationPromptVersion" 1 "Data\\NVSE\\Plugins\\dialectic_custom.ini"

    if eval iButton != 0
        return
    endif

    MessageExAlt 4 "#4|Dialectic initialization has started. Please wait."
    call (CompileScript "Dialectic/RunDialecticInitialization.gek")
End
