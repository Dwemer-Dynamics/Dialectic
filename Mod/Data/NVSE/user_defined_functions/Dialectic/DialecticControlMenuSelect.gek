int iButton

Begin Function {iButton}
    if eval iButton < 0 || iButton > 4
        return
    endif

    if eval iButton == 0
        DialecticToggleInteraction
    elseif eval iButton == 1
        DialecticOpenModeMenu
    elseif eval iButton == 2
        DialecticOpenLLMModelMenu
    elseif eval iButton == 3
        DialecticOpenDynamicProfileMenu
    elseif eval iButton == 4
        DialecticWaitHereTarget
    endif
End
