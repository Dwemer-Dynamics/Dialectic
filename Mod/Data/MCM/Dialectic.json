    "1": {
      "listTitle": "Hotkeys",
      "pageTitle": "Hotkeys",
      "columns": 1,
      "enable": 1,
      "options": {
        "1": {
          "title": "Chatbox",
          "type": 3,
          "enable": 1,
          "mouse": "Tap to open the text chatbox. Hold to make the NPC in your crosshair wait here. Unbound by default.",
          "vars": [
            {
              "configINI": "Hotkeys:TalkToNPC",
              "default": 0
            }
          ],
          "keybind": {
            "type": 0
          },
          "call": {
            "type": "file",
            "value": "Dialectic/MCMReload.gek"
          }
        },
        "2": {
          "title": "Voice Chat",
          "type": 3,
          "enable": 1,
          "mouse": "Hold to talk. Tap to stop current and queued dialogue, or double-tap to make the NPC in your crosshair wait here. Unbound by default.",
          "vars": [
            {
              "configINI": "Hotkeys:ToggleVoice",
              "default": 0
            }
          ],
          "keybind": {
            "type": 0
          },
          "call": {
            "type": "file",
            "value": "Dialectic/MCMReload.gek"
          }
        },
        "3": {
          "title": "DIALECTIC Control",
          "type": 3,
          "enable": 1,
          "mouse": "Keyboard key for opening chat mode, LLM model, dynamic profile, and targeted NPC controls. Unbound by default.",
          "vars": [
            {
              "configINI": "Hotkeys:DialecticControl",
              "default": 0
            }
          ],
          "keybind": {
            "type": 0
          },
          "call": {
            "type": "file",
            "value": "Dialectic/MCMReload.gek"
          }
        },
        "4": {
          "title": "Manual AI Activate",
          "type": 3,
          "enable": 1,
          "mouse": "Keyboard key for manually activating the targeted NPC as an AI agent. Unbound by default.",
          "vars": [
            {
              "configINI": "Hotkeys:ManualActivate",
              "default": 0
            }
          ],
          "keybind": {
            "type": 0
          },
          "call": {
            "type": "file",
            "value": "Dialectic/MCMReload.gek"
          }
        },
        "5": {
          "title": "Halt AI Actions",
          "type": 3,
          "enable": 1,
          "mouse": "Keyboard key for the hard killswitch: stops AI dialogue, clears queues, cancels requests, and halts active NPC actions. Unbound by default.",
